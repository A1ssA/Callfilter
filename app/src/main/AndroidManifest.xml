<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions strictement nécessaires et locales -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Pour la programmation horaire précise -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- AUCUNE permission INTERNET pour garantir le 100% hors-ligne -->

    <application
        android:name=".CallGuardApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CallGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service de filtrage natif Android -->
        <service
            android:name=".service.CallGuardScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Récepteur pour les plages horaires automatiques et le redémarrage -->
        <receiver
            android:name=".scheduler.ScheduleAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.callguard.app.ACTION_TRIGGER_SCHEDULE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
